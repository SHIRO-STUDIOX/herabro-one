{
  "name": "hamafzar-rn",
  "version": "0.1.0",
  "type": "module",
  "description": "Hamafzar Release Notes & Changelog Drawer Widget for Vue 3",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "prepare": "npm run build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.3.0 || ^3.4.0 || ^3.5.0"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "changelog",
    "release-notes",
    "widget",
    "sidebar",
    "hamafzar",
    "hesabro"
  ],
  "author": "Hesabro / Avapardaz",
  "license": "MIT"
}
